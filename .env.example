# ============================================================
# AI Engineer Learning Track - Environment Variables Template
# Copy this file to .env and fill in your actual keys:
#   cp .env.example .env
# ============================================================

# Primary LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vector Database (Qdrant Cloud or Local Docker)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Tool & Search APIs (Agents)
TAVILY_API_KEY=your_tavily_api_key_here
