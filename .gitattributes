# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.cpp text eol=lf

# Binary files
*.pdf binary
*.docx binary
*.npz binary

